<?xml version="1.0" encoding="utf-8"?>
<executable>
    <category>MIATT.HW04.jingmliang</category>
    <title>Simple Threshold</title>
    <description>
        A simple thresholding filter for ECE:5490 HW04.
    </description>
    <version>1.0.0</version>
    <documentation-url></documentation-url>
    <license></license>
    <contributor>jingmliang</contributor>

    <parameters>
        <label>IO</label>
        <description>Input/output parameters</description>
        <image>
            <name>inputVolume</name>
            <longflag>inputVolume</longflag>
            <label>Input Volume</label>
            <channel>input</channel>
            <description>Input volume to be filtered</description>
        </image>
        <image>
            <name>outputVolume</name>
            <longflag>outputVolume</longflag>
            <label>Output Volume</label>
            <channel>output</channel>
            <description>Output filtered volume</description>
        </image>
    </parameters>

    <parameters>
        <label>Threshold Settings</label>
        <description>Parameters for the threshold filter</description>
        <integer>
            <name>lowThreshold</name>
            <longflag>lowThreshold</longflag>
            <label>Low Threshold</label>
            <description>Lower bound of the threshold</description>
            <default>50</default>
            <constraints>
                <minimum>-1000</minimum>
                <maximum>3000</maximum>
                <step>1</step>
            </constraints>
        </integer>
        <integer>
            <name>highThreshold</name>
            <longflag>highThreshold</longflag>
            <label>High Threshold</label>
            <description>Upper bound of the threshold</description>
            <default>100</default>
            <constraints>
                <minimum>-1000</minimum>
                <maximum>3000</maximum>
                <step>1</step>
            </constraints>
        </integer>
        <integer>
            <name>outsideValue</name>
            <longflag>outsideValue</longflag>
            <label>Outside Value</label>
            <description>Value assigned to pixels outside the threshold range</description>
            <default>150</default>
        </integer>
        <integer>
            <name>insideValue</name>
            <longflag>insideValue</longflag>
            <label>Inside Value</label>
            <description>Value assigned to pixels inside the threshold range</description>
            <default>200</default>
        </integer>
    </parameters>
</executable>

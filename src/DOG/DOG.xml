<?xml version="1.0" encoding="utf-8"?>
<executable>
    <category>MIATT.HW04.jingmliang</category>
    <title>Difference of Gaussians</title>
    <description>DOG filter for HW04.</description>
    <version>1.0.0</version>
    <contributor>jingmliang</contributor>

    <parameters>
        <label>IO</label>
        <description>Input/output parameters</description>
        <image>
            <name>inputVolume</name>
            <longflag>inputVolume</longflag>
            <label>Input Volume</label>
            <channel>input</channel>
            <description>Input volume</description>
        </image>
        <image>
            <name>outputVolume</name>
            <longflag>outputVolume</longflag>
            <label>Output Volume</label>
            <channel>output</channel>
            <description>Output edge-enhanced volume</description>
        </image>
    </parameters>

    <parameters>
        <label>Filter Settings</label>
        <description>Sigma parameters for Difference of Gaussians filter</description>
        <double>
            <name>sigma1</name>
            <longflag>sigma1</longflag>
            <label>Sigma 1</label>
            <description>Standard deviation for the first Gaussian kernel. Typically the smaller sigma.</description>
            <default>2.5</default>
            <constraints>
                <minimum>0.1</minimum>
                <maximum>10.0</maximum>
                <step>0.1</step>
            </constraints>
        </double>
        <double>
            <name>sigma2</name>
            <longflag>sigma2</longflag>
            <label>Sigma 2</label>
            <description>Standard deviation for the second Gaussian kernel. Typically the larger sigma.</description>
            <default>3.5</default>
            <constraints>
                <minimum>0.1</minimum>
                <maximum>10.0</maximum>
                <step>0.1</step>
            </constraints>
        </double>
    </parameters>
</executable>
<?xml version="1.0" encoding="utf-8"?>
<executable>
    <category>MIATT.HW04.jingmliang</category>
    <title>Gradient AD</title>
    <description>Gradient Anisotropic Diffusion for HW04.</description>
    <version>1.0.0</version>
    <contributor>jingmliang</contributor>

    <parameters>
        <label>IO</label>
        <description>Input/output parameters</description>
        <image>
            <name>inputVolume</name>
            <longflag>inputVolume</longflag>
            <label>Input Volume</label>
            <channel>input</channel>
            <description>Input volume</description>
        </image>
        <image>
            <name>outputVolume</name>
            <longflag>outputVolume</longflag>
            <label>Output Volume</label>
            <channel>output</channel>
            <description>Output filtered volume</description>
        </image>
    </parameters>

    <parameters>
        <label>Filter Settings</label>
        <description>Parameters for the Gradient Anisotropic Diffusion filter</description>
        <double>
            <name>conductance</name>
            <longflag>conductance</longflag>
            <label>Conductance</label>
            <description>Conductance parameter controlling the diffusion rate. Higher values preserve fewer edges.</description>
            <default>2.0</default>
            <constraints>
                <minimum>0.0</minimum>
                <maximum>10.0</maximum>
                <step>0.1</step>
            </constraints>
        </double>
        <double>
            <name>timeStep</name>
            <longflag>timeStep</longflag>
            <label>Time Step</label>
            <description>Time step for the diffusion process. For 3D images, it should be less than 0.125 for stability.</description>
            <default>0.1</default>
            <constraints>
                <minimum>0.0</minimum>
                <maximum>0.125</maximum>
                <step>0.01</step>
            </constraints>
        </double>
        <integer>
            <name>iterations</name>
            <longflag>iterations</longflag>
            <label>Iterations</label>
            <description>Number of iterations to run the diffusion process.</description>
            <default>5</default>
            <constraints>
                <minimum>1</minimum>
                <maximum>100</maximum>
                <step>1</step>
            </constraints>
        </integer>
    </parameters>
</executable>